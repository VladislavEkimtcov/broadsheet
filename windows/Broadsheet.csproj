<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (non-SDK) project on purpose: it builds with the MSBuild 4.0 and C# 5 compiler that ship
     inside Windows (.NET Framework 4.8), with no SDK, no Visual Studio and no NuGet. See build.cmd. -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>Broadsheet</RootNamespace>
    <AssemblyName>Broadsheet</AssemblyName>
    <OutputPath>bin\</OutputPath>
    <IntermediateOutputPath>obj\</IntermediateOutputPath>
    <Configuration>Release</Configuration>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <WarningLevel>4</WarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The window's icon (MainWindow.MakeIcon), drawn by tools/windows-icon.py, so the exe, the
         Start menu shortcut and Explorer show it too. -->
    <ApplicationIcon>Broadsheet.ico</ApplicationIcon>
    <GenerateManifests>false</GenerateManifests>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <DefineConstants Condition="'$(EnableAutoUpdate)' == 'true'">ENABLE_AUTO_UPDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- Windows' own video player (WinRT) for Video.cs: the metadata every Windows 10 and 11 has
         in System32\WinMetadata, and the .NET Framework's WinRT interop, both in the box. -->
    <Reference Include="System.Runtime"><Private>false</Private></Reference>
    <Reference Include="System.Runtime.WindowsRuntime"><Private>false</Private></Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime"><Private>false</Private></Reference>
    <Reference Include="Windows.Foundation"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Foundation.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Media"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Media.winmd</HintPath><Private>false</Private></Reference>
    <Reference Include="Windows.Graphics"><HintPath>$(WINDIR)\System32\WinMetadata\Windows.Graphics.winmd</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Compile Include="src\App.xaml.cs"><DependentUpon>App.xaml</DependentUpon></Compile>
    <Compile Include="src\AssemblyInfo.cs" />
    <Compile Include="$(IntermediateOutputPath)Version.cs" />
    <Compile Include="src\Json.cs" />
    <Compile Include="src\Net.cs" />
    <Compile Include="src\Dates.cs" />
    <Compile Include="src\Sun.cs" />
    <Compile Include="src\Updates.cs" />
    <Compile Include="src\Updater.cs" />
    <Compile Include="src\Model.cs" />
    <Compile Include="src\Store.cs" />
    <Compile Include="src\Ladder.cs" />
    <Compile Include="src\Sse.cs" />
    <Compile Include="src\Bodies.cs" />
    <Compile Include="src\Relay.cs" />
    <Compile Include="src\Events.cs" />
    <Compile Include="src\Ui.cs" />
    <Compile Include="src\Images.cs" />
    <Compile Include="src\Scroller.cs" />
    <Compile Include="src\Swipe.cs" />
    <Compile Include="src\Card.cs" />
    <Compile Include="src\Front.cs" />
    <Compile Include="src\Reader.cs" />
    <Compile Include="src\Options.cs" />
    <Compile Include="src\Video.cs" />
    <Compile Include="src\Player.cs" />
    <Compile Include="src\MainWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Newsreader (SIL OFL 1.1), the same cuts the TV app ships, compiled into the exe. -->
    <Resource Include="..\assets\fonts\newsreader-*.ttf">
      <Link>fonts\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- One version for every port: VERSION_NAME in ..\version.env (the Android build reads it too)
       becomes the assembly and file version. Property functions and WriteLinesToFile are in
       MSBuild 4.0, so this needs nothing beyond what Windows ships. -->
  <PropertyGroup>
    <VersionFile>$(MSBuildProjectDirectory)\..\version.env</VersionFile>
  </PropertyGroup>
  <Target Name="StampVersion" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(VersionFile)')" Text="$(VersionFile) is missing: copy version.env next to windows\ (with assets\ and spec\)." />
    <PropertyGroup>
      <VersionText>$([System.IO.File]::ReadAllText('$(VersionFile)'))</VersionText>
      <VersionName>$([System.Text.RegularExpressions.Regex]::Match('$(VersionText)', '(?&lt;=VERSION_NAME=)[0-9]+\.[0-9]+\.[0-9]+'))</VersionName>
    </PropertyGroup>
    <Error Condition="'$(VersionName)' == ''" Text="No VERSION_NAME=X.Y.Z in $(VersionFile)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)Version.cs" Overwrite="true"
      Lines="// Made by the build from version.env;[assembly: System.Reflection.AssemblyVersion(&quot;$(VersionName).0&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(VersionName).0&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(VersionName)&quot;)]" />
    <Message Importance="high" Text="Broadsheet $(VersionName)" />
  </Target>
</Project>
