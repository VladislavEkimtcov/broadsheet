{
  "about": "Responsive grid tiers and card layout (FeedLayout.java and windows/src/FeedLayout.cs, features phone.layout and win.responsive). Rail collapses below 840; columns step 1 (< 540), 2 (540..859), 3 (>= 860). Each planned slot formats as '<story>:<H|T|B|C>@r<row>c<col>+<span/gridCols>[#stack/stackCount]'.",
  "rail": [
    { "name": "wide desktop keeps left rail", "width": 1280, "collapsed": false, "pad": 34 },
    { "name": "at threshold 840 keeps rail", "width": 840, "collapsed": false, "pad": 34 },
    { "name": "half-screen DOORWEDGE 683 collapses rail", "width": 683, "collapsed": true, "pad": 20 },
    { "name": "very narrow window uses tight gutter", "width": 440, "collapsed": true, "pad": 16 }
  ],
  "columns": [
    { "name": "upright phone 370dp", "width": 370, "expect": 1 },
    { "name": "narrow 539", "width": 539, "expect": 1 },
    { "name": "threshold 540 uses two columns", "width": 540, "expect": 2 },
    { "name": "collapsed half-screen content 643 uses two columns", "width": 643, "expect": 2 },
    { "name": "859 uses two columns", "width": 859, "expect": 2 },
    { "name": "threshold 860 uses three columns", "width": 860, "expect": 3 },
    { "name": "DOORWEDGE full content 1074 uses three columns", "width": 1074, "expect": 3 }
  ],
